# ── LangFuse ──────────────────────────────────────────────────────────────────
LANGFUSE_HOST=http://<langfuse-internal-host>
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://<mlflow-internal-host>
MLFLOW_TRACKING_TOKEN=
MLFLOW_EXPERIMENT_NAME=adk/nebula
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://<mlflow-internal-host>/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=x-mlflow-experiment-id=<experiment-id>

# ── Label Studio ──────────────────────────────────────────────────────────────
LABEL_STUDIO_URL=http://<label-studio-internal-host>
LABEL_STUDIO_API_KEY=

# ── Claude / ADK ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Alerts ────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Auth ──────────────────────────────────────────────────────────────────────
GDT_TOKEN_HEADER=X-GDT-Token
